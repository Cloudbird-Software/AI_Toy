# LLM API 环境变量模板（复制为私有文件后 export；勿把 key 提交进仓库）
#   cp configs/llm/api.env.example ~/llm.env && 编辑后 `set -a; source ~/llm.env; set +a`
# 兼容契约：任意 OpenAI 兼容端点（/v1/chat/completions）。

# ---- 必填（synthgen generate-llm 与 LLM_JUDGE）----
export LLM_API_BASE="https://api.example.com/v1"   # 兼容端点
export LLM_API_KEY="sk-xxxx"                        # 密钥（只经环境注入，.gitignore 排除 .env*）
export LLM_MODEL_TEXT="your-text-model"             # 文本模型名

# ---- 多模型池（推荐 ≥4 个：T2 单源占比 ≤30% 门禁的硬要求）----
# synthgen generate-llm 按样本轮转该池，每条样本溯源戳记录实际模型；
# 只配单模型时 dist-check 会诚实失败（share=1.00 > 0.30）。
export LLM_MODELS_TEXT_POOL="model-a,model-b,model-c,model-d"

# ---- 其余模态（当前预留：TTS/ASR/图尚未接线，接线卡引用本模板）----
# export LLM_MODEL_TTS="your-tts-model"      # T13 端云 TTS 路由的云档（后续卡）
# export LLM_MODEL_ASR="your-asr-model"      # 语音识别面（后续卡）
# export LLM_MODEL_IMAGE="your-image-model"  # 场景包插画（T16，后续卡）

# ---- judge 开关 ----
# export LLM_JUDGE=1    # toyjudge run 的 LLM 后端开关（judge 身份沿用
#                       # configs/judge/model.yaml 锁定模型名——API 端点须提供同名模型）
